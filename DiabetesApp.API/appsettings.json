{
  // CORS: list every exact browser origin (scheme + host + port) that calls this API. Wildcard is not allowed with AllowCredentials.
  // On a host, you can set Cors__AllowedOrigins__0, Cors__AllowedOrigins__1, ... or override this file per environment.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  // Secrets: use dotnet user-secrets (Development) or environment variables on the server (ConnectionStrings__*, JWT__*).
  "ConnectionStrings": {
    "DefaultConnection": "",
    "IdentityConnection": ""
  },
  "JWT": {
    "Key": "",
    "ValidIssuer": "",
    "ValidAudience": "",
    "DurationInDays": "10"
  }
}
